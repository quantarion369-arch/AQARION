{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/quantarion369-arch/AQARION/blob/main/AQARION-QUANTARION-AI/TOOLS/CLAIMLOCK/schemas/registry.schema.json",
  "title": "AQARION Claim Registry",
  "description": "Schema for the AQARION claim registry array. Status tracks evidence strength; governance tracks publication disposition separately.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "status",
      "governance",
      "evidence",
      "note"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Z0-9-]+$"
      },
      "title": {
        "type": "string"
      },
      "status": {
        "enum": [
          "proved",
          "verified",
          "conjecture",
          "open",
          "deprecated",
          "blocked"
        ]
      },
      "governance": {
        "enum": [
          "active",
          "deprecated",
          "blocked"
        ]
      },
      "evidence": {
        "type": "string"
      },
      "cases": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0,
        "description": "Nonnegative recorded count; null means count scope is not established. Null is restricted to explicitly identified legacy records and requires count_provenance."
      },
      "violations": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0,
        "description": "Nonnegative recorded count; null means count scope is not established. Null is restricted to explicitly identified legacy records and requires count_provenance."
      },
      "note": {
        "type": "string"
      },
      "count_provenance": {
        "type": "string",
        "minLength": 1
      },
      "record_type": {
        "const": "formal"
      },
      "claim_text": {
        "type": "string",
        "minLength": 1
      },
      "formal_evidence": {
        "type": "object",
        "required": [
          "repo",
          "revision",
          "source_path",
          "source_file_sha256",
          "declaration",
          "statement_sha256",
          "receipt_path",
          "receipt_sha256",
          "correspondence_review"
        ],
        "properties": {
          "repo": {
            "const": "https://github.com/quantarion369-arch/AQARION-LEAN"
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "source_file_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "declaration": {
            "type": "string",
            "minLength": 1
          },
          "statement_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "receipt_path": {
            "type": "string",
            "minLength": 1
          },
          "receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "correspondence_review": {
            "type": "object",
            "required": [
              "state",
              "reviewer"
            ],
            "properties": {
              "state": {
                "enum": [
                  "pending",
                  "approved"
                ]
              },
              "reviewer": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "claim_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "declaration": {
                "type": "string",
                "minLength": 1
              },
              "statement_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "reviewed_at": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "allowed_axioms": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "propext",
                "Classical.choice",
                "Quot.sound"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "record_type": {
              "const": "formal"
            }
          },
          "required": [
            "record_type"
          ]
        },
        "then": {
          "required": [
            "claim_text",
            "formal_evidence"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "cases"
                ]
              },
              {
                "required": [
                  "violations"
                ]
              }
            ]
          }
        },
        "else": {
          "required": [
            "cases",
            "violations"
          ],
          "allOf": [
            {
              "if": {
                "anyOf": [
                  {
                    "properties": {
                      "cases": {
                        "type": "null"
                      }
                    },
                    "required": [
                      "cases"
                    ]
                  },
                  {
                    "properties": {
                      "violations": {
                        "type": "null"
                      }
                    },
                    "required": [
                      "violations"
                    ]
                  }
                ]
              },
              "then": {
                "required": [
                  "count_provenance"
                ],
                "properties": {
                  "id": {
                    "enum": [
                      "PB-006-AGGREGATE-NOVELTY",
                      "CG-INEQUALITY",
                      "CG-WITNESS-PAIR",
                      "CG-ITINERARY-CRITERION",
                      "CG-GAP2-COUNTEREXAMPLE",
                      "CG-CYCLIC-GAP-FORMULA",
                      "CG-GAP-UNBOUNDED",
                      "CG-MAX-CENSUS",
                      "CG-GENERAL-MAX"
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      {
        "if": {
          "required": [
            "formal_evidence"
          ]
        },
        "then": {
          "required": [
            "record_type"
          ]
        }
      }
    ]
  }
}
