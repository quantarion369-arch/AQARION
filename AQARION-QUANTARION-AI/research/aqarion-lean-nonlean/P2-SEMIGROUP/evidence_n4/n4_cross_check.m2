-- n=4 cross-check in Macaulay2. UNTESTED: written without access to Macaulay2.
kk = ZZ/32003;
R = kk[A,C,E0,E1,E2,E3,B0,B1,B2,B3, Degrees=>{1,2,1,1,1,1,2,2,2,2}];
I1 = ideal {A*B0-E1*E2*E3, A*B1-E0*E2*E3, A*B2-E0*E1*E3, A*B3-E0*E1*E2,
            E0*B0-A*C, E1*B1-A*C, E2*B2-A*C, E3*B3-A*C,
            B0*B1-C*E2*E3, B0*B2-C*E1*E3, B0*B3-C*E1*E2,
            B1*B2-C*E0*E3, B1*B3-C*E0*E2, B2*B3-C*E0*E1};
-- toric ideal of the semigroup generated by the ten vectors
T = kk[a0,a1,a2,a3,k,ki]/ideal(k*ki-1);
phi = map(T, R, {ki, k^2*a0*a1*a2*a3, a0,a1,a2,a3, k*a1*a2*a3, k*a0*a2*a3, k*a0*a1*a3, k*a0*a1*a2});
I2 = ker phi;
print("1. the 14 binomials generate the toric ideal: " | toString(I1 == I2));
print("2. codim = 5: " | toString(codim I1 == 5));
Bt = betti res I1;
print Bt;
-- expected totals 1,14,35,35,14,1; (i,weight): (1,3)x8 (1,4)x6 (2,4)x3 (2,5)x24 (2,6)x8 (3,6)x8 (3,7)x24 (3,8)x3 (4,8)x6 (4,9)x8 (5,12)x1
S = kk[A,C,E0,E1,E2,E3,B0,B1,B2,B3, MonomialOrder=>{Weights=>{4,1,2,2,2,2,4,4,4,4}, Lex}];
J = sub(I1, S);
L = ideal(A*B0,A*B1,A*B2,A*B3,E0*B0,E1*B1,E2*B2,E3*B3,B0*B1,B0*B2,B0*B3,B1*B2,B1*B3,B2*B3,A^2*C);
print("3. initial ideal for weights (4,1,2,2,2,2,4,4,4,4), lex tie-break, equals L: " | toString(ideal leadTerm gens gb J == sub(L,S)));
Ib = ideal sub(gens I1, {A=>0, C=>0});
M4 = ideal(E1*E2*E3,E0*E2*E3,E0*E1*E3,E0*E1*E2,E0*B0,E1*B1,E2*B2,E3*B3,B0*B1,B0*B2,B0*B3,B1*B2,B1*B3,B2*B3);
print("4. I1 mod (A,C) equals the monomial ideal M4: " | toString(Ib == M4));
print("5. Betti table of R/(A,C) equals that of R: " | toString(betti res Ib == Bt));
print("6. codim of I1+(A,C) is 7: " | toString(codim(I1 + ideal(A,C)) == 7));
print hilbertSeries(R^1/I1, Reduce=>true);
